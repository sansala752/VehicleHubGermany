{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@prisma/client", "./node_modules/@types"],
    "moduleResolution": "nodenext",
  },
  "include": ["src", "src/config/prisma.config.ts"],
  "exclude": ["node_modules", "dist"]
}